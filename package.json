{
  "name": "avatar-laura",
  "private": true,
  "version": "0.1.0",
  "description": "My Town, My World (Minha Cidade, Meu Mundo) - jogo infantil de valores do dia a dia, feito com Phaser 3 + Vite + TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:emojis": "node scripts/check-emojis.mjs",
    "test:e2e": "playwright test",
    "test:e2e:contas": "playwright test --config playwright.contas.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
